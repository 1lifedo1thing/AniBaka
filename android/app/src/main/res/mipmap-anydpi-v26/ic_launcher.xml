<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_backdrop" />
    <foreground>
        <!-- The full-bleed illustration belongs in the visible 72/108 area.
             Fractional insets preserve its framing at every launcher size. -->
        <inset
            android:drawable="@drawable/ic_launcher_artwork"
            android:insetLeft="16.666667%"
            android:insetTop="16.666667%"
            android:insetRight="16.666667%"
            android:insetBottom="16.666667%" />
    </foreground>
</adaptive-icon>
